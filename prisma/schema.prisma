// Prisma schema — TensorLogix (NEXTJS_TMA_MALL_V10_1)
// Базовый каркас маркетплейса, созданный ДО прожарки ТЗ.
// Модели вендоров/комиссий/доставки будут добавлены миграциями
// по результатам /grill-me. Подробнее: docs/prisma.io

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Каркас маркетплейса v1.0 (users/categories/products/orders) УДАЛЁН 24.08.2026:
// мультиарендность аннулирована PIVOT'ом v2.0 (решение #12).

// ============================================================
// Leads — заявки со смарт-калькулятора сайта (ТЗ, раздел 6).
// При отправке формы фиксация намертво: смета + контакты.
// ============================================================

enum LeadStatus {
  NEW
  IN_PROGRESS
  WON
  LOST
}

// Заявка v2 (ТЗ v2.0 §6): конфигурация калькулятора в Json,
// итоги и контакты формы захвата намертво.
model Lead {
  id String @id @default(cuid())

  // Калькулятор v2: { products: [], addons: [], marketing: [] }
  config Json

  // Итоги расчёта, зафиксированные при отправке
  totalPrice Decimal @db.Decimal(12, 2)
  totalDays Int

  // Форма захвата: имя, Telegram/телефон, детали задачи
  contactName String
  contactChannel String
  details String?

  // CRM будущего CONTROL TERMINAL
  status LeadStatus @default(NEW)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("leads")
}

// ============================================================
// CMS (тикет ADMIN, решение #10 от 24.08.2026): динамические
// скидки/акции/промокоды и базовые цены калькулятора.
// ============================================================

model Promotion {
  id          String   @id @default(cuid())
  title       String // название акции («Стартовая акция −10%»)
  description String // подробные условия для страницы /promotions
  discountPct Float    @default(0) // размер скидки, %
  promoCode   String?  @unique // опциональный промокод для ручного ввода
  active      Boolean  @default(true) // флаг из админки
  startsAt    DateTime? // окно действия (null = без ограничения)
  endsAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
  @@map("promotions")
}

model Setting {
  key       String   @id // например "price_book" — переопределение базовых цен
  value     Json // произвольная JSON-структура значения
  updatedAt DateTime @updatedAt

  @@map("settings")
}
