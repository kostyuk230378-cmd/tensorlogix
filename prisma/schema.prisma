// Prisma schema — TensorLogix (NEXTJS_TMA_MALL_V10_1)
// Базовый каркас маркетплейса, созданный ДО прожарки ТЗ.
// Модели вендоров/комиссий/доставки будут добавлены миграциями
// по результатам /grill-me. Подробнее: docs/prisma.io

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  COMPLETED
  CANCELLED
}

// Пользователь: вход через Telegram Mini App (telegramId из initData)
model User {
  id         String   @id @default(cuid())
  telegramId BigInt?  @unique
  username   String?
  firstName  String?
  lastName   String?
  role       UserRole @default(CUSTOMER)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  orders     Order[]

  @@map("users")
}

model Category {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  products  Product[]
  createdAt DateTime  @default(now())

  @@map("categories")
}

model Product {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  description String?
  price       Decimal     @db.Decimal(12, 2)
  currency    String      @default("RUB")
  imageUrl    String?
  stock       Int         @default(0)
  isActive    Boolean     @default(true)
  category    Category?   @relation(fields: [categoryId], references: [id])
  categoryId  String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orderItems  OrderItem[]

  @@index([categoryId])
  @@map("products")
}

model Order {
  id        String      @id @default(cuid())
  user      User        @relation(fields: [userId], references: [id])
  userId    String
  status    OrderStatus @default(PENDING)
  total     Decimal     @db.Decimal(12, 2)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  items     OrderItem[]

  @@index([userId])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  product   Product @relation(fields: [productId], references: [id])
  productId String
  quantity  Int     @default(1)
  unitPrice Decimal @db.Decimal(12, 2)

  @@index([orderId])
  @@map("order_items")
}

// ============================================================
// Leads — заявки со смарт-калькулятора сайта (ТЗ, раздел 6).
// При отправке формы фиксация намертво: смета + контакты.
// ============================================================

enum SiteType {
  VISIT_CARD // Визитка
  LANDING // Лендинг
  PRESENTATION // Презентационный сайт
  SHOP // Магазин
  MARKETPLACE // Большой маркетплейс
}

enum PaymentGateway {
  YOOKASSA // ЮKassa
  TBANK // Т-Банк
}

enum TmaPaymentMethod {
  CARDS // Карты
  TELEGRAM_STARS // Telegram Stars
}

enum LeadStatus {
  NEW
  IN_PROGRESS
  WON
  LOST
}

model Lead {
  id String @id @default(cuid())

  // Блок 1: тип сайта
  siteType SiteType
  // Блок 2: интеграции сайта (только для SHOP / MARKETPLACE)
  sitePayment PaymentGateway?
  siteLogistics Boolean @default(false) // СДЭК

  // Блок 3: модуль Telegram Mini App (toggle)
  tmaEnabled Boolean @default(false)
  // Блок 4: интеграции Mini App (только если tmaEnabled && SHOP/MARKETPLACE)
  tmaPayment TmaPaymentMethod?
  tmaLogistics Boolean @default(false) // СДЭК

  // Блок 5: модуль управления (единая админка)
  adminPanel Boolean @default(false)

  // Модуль интернет-маркетинга (чекбоксы)
  mktYandex Boolean @default(false) // Яндекс (Директ, Поиск)
  mktGoogle Boolean @default(false) // Google (SEO)
  mktTelegramAds Boolean @default(false) // Реклама в Telegram
  mktSocial Boolean @default(false) // Продвижение в соцсетях

  // Итоги расчёта, зафиксированные при отправке
  totalPrice Decimal @db.Decimal(12, 2)
  totalDays Int
  quoteSnapshot Json // детальная смета: [{ item, price, days }]

  // Контакты формы захвата: Имя, Телефон/Telegram, Email
  contactName String
  contactPhone String
  contactEmail String?

  // CRM (ТЗ раздел 6: таблица лидов в админке)
  status LeadStatus @default(NEW)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("leads")
}
